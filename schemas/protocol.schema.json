{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ubuntuokos/CFA4-sdk/schemas/protocol.schema.json",
  "title": "CFA4 AI worker protocol message",
  "description": "One JSON-lines message between the CFA4 host and a worker. Protocol version 2; version 1 (no caps.features, caps.post_export or caps.limits.watermark_above_height) is still accepted. Frames travel in shared memory; messages only reference them.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/caps" },
    { "$ref": "#/$defs/load" },
    { "$ref": "#/$defs/loaded" },
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/unload" },
    { "$ref": "#/$defs/stats" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/shutdown" }
  ],
  "$defs": {
    "id": {
      "description": "Message id, unique per connection and direction.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replyTo": {
      "description": "Id of the request this message answers.",
      "$ref": "#/$defs/id"
    },
    "jobId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "impl": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "device": {
      "description": "Execution device: \"cpu\", or an index into the GPUs the host made visible to this worker.",
      "oneOf": [
        { "const": "cpu" },
        { "type": "integer", "minimum": 0, "maximum": 63 }
      ]
    },
    "precision": { "enum": ["fp32", "fp16", "bf16", "fp8", "int8", "int4"] },
    "tier": { "enum": ["preview", "standard", "final"] },
    "buffer": {
      "description": "A frame or tensor in a shared-memory segment the host created.",
      "type": "object",
      "additionalProperties": false,
      "required": ["shm", "offset", "len", "kind"],
      "properties": {
        "shm": { "type": "string", "pattern": "^/cfa4-ai-[A-Za-z0-9_-]{1,64}$" },
        "offset": { "type": "integer", "minimum": 0 },
        "len": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "kind": { "enum": ["frame", "mask", "audio", "tensor", "json"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "stride": { "type": "integer", "minimum": 1 },
        "frames": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "format": { "enum": ["rgb8", "rgba8", "rgb16f", "rgba16f", "rgba32f", "gray8", "gray16", "gray32f", "pcm-f32", "utf8-json"] },
        "color": { "enum": ["srgb", "rec709", "rec2020-pq", "rec2020-hlg", "linear-srgb", "acescg"] },
        "premultiplied": { "type": "boolean" }
      },
      "if": { "properties": { "kind": { "enum": ["frame", "mask"] } } },
      "then": { "required": ["width", "height", "stride", "format"] }
    },
    "frameRange": {
      "description": "Frame indices in the source's own frame rate; the host converts to ticks.",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "count"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "hello": {
      "description": "Host -> worker, first message on the socket.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "protocol", "host"],
      "properties": {
        "type": { "const": "hello" },
        "id": { "$ref": "#/$defs/id" },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "host": { "type": "string", "maxLength": 120 }
      }
    },
    "caps": {
      "description": "Worker -> host, answer to hello. The chosen protocol must lie in the host's range.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "reply_to", "protocol", "worker", "impls", "limits"],
      "properties": {
        "type": { "const": "caps" },
        "id": { "$ref": "#/$defs/id" },
        "reply_to": { "$ref": "#/$defs/replyTo" },
        "protocol": { "type": "integer", "minimum": 1 },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
            "version": { "type": "string", "maxLength": 64 },
            "license": { "description": "SPDX expression of the worker itself.", "type": "string" }
          }
        },
        "impls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/impl" }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_jobs"],
          "properties": {
            "max_jobs": { "type": "integer", "minimum": 1, "maximum": 64 },
            "max_buffer_bytes": { "type": "integer", "minimum": 1 },
            "max_duration_s": {
              "description": "Usage cap a paid worker enforces itself, if any.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_output_height": {
              "description": "Output-quality cap a paid worker enforces itself, if any.",
              "type": "integer",
              "minimum": 1
            },
            "watermark_above_height": {
              "description": "Version 2. Without a licence key, output taller than this many pixels carries a visible watermark the worker adds itself.",
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "devices": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/device" } },
        "features": {
          "description": "Version 2. Optional behaviours the worker supports; the host offers only these. cancel: stops a run mid-chunk; progress: sends progress; preview: honours tier preview; resume: continues a job from its last finished chunk.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["cancel", "progress", "preview", "resume"] }
        },
        "post_export": {
          "description": "Version 2. One of impls: the host runs it on every exported frame that contains this worker's output, after export and before the file is final.",
          "$ref": "#/$defs/impl"
        }
      },
      "if": { "properties": { "protocol": { "const": 1 } } },
      "then": {
        "properties": {
          "features": false,
          "post_export": false,
          "limits": { "properties": { "watermark_above_height": false } }
        }
      }
    },
    "load": {
      "description": "Host -> worker: load an implementation's weights onto a GPU.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "impl", "device"],
      "properties": {
        "type": { "const": "load" },
        "id": { "$ref": "#/$defs/id" },
        "impl": { "$ref": "#/$defs/impl" },
        "device": { "$ref": "#/$defs/device" },
        "precision": { "$ref": "#/$defs/precision" },
        "weights_dir": { "description": "Absolute path of the user's model folder.", "type": "string", "pattern": "^/" }
      }
    },
    "loaded": {
      "description": "Worker -> host: load finished.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "reply_to", "impl", "vram_mb"],
      "properties": {
        "type": { "const": "loaded" },
        "id": { "$ref": "#/$defs/id" },
        "reply_to": { "$ref": "#/$defs/replyTo" },
        "impl": { "$ref": "#/$defs/impl" },
        "vram_mb": { "type": "integer", "minimum": 0 }
      }
    },
    "run": {
      "description": "Host -> worker: run one job (or one chunk of a job).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "job", "impl", "device", "inputs", "outputs", "params", "tier"],
      "properties": {
        "type": { "const": "run" },
        "id": { "$ref": "#/$defs/id" },
        "job": { "$ref": "#/$defs/jobId" },
        "impl": { "$ref": "#/$defs/impl" },
        "device": { "$ref": "#/$defs/device" },
        "inputs": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "additionalProperties": { "$ref": "#/$defs/buffer" }
        },
        "outputs": {
          "description": "Buffers the host pre-allocated for the results.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "additionalProperties": { "$ref": "#/$defs/buffer" }
        },
        "params": { "description": "Validated against the manifest's params schema.", "type": "object" },
        "tier": { "$ref": "#/$defs/tier" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "range": { "$ref": "#/$defs/frameRange" },
        "chunk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "count"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "count": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "progress": {
      "description": "Worker -> host, optional, any number per run.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "reply_to", "job", "done", "total"],
      "properties": {
        "type": { "const": "progress" },
        "id": { "$ref": "#/$defs/id" },
        "reply_to": { "$ref": "#/$defs/replyTo" },
        "job": { "$ref": "#/$defs/jobId" },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "stage": { "type": "string", "maxLength": 64 }
      }
    },
    "result": {
      "description": "Worker -> host: the run finished and the output buffers are written.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "reply_to", "job", "outputs"],
      "properties": {
        "type": { "const": "result" },
        "id": { "$ref": "#/$defs/id" },
        "reply_to": { "$ref": "#/$defs/replyTo" },
        "job": { "$ref": "#/$defs/jobId" },
        "outputs": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "additionalProperties": { "$ref": "#/$defs/buffer" }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "elapsed_ms": { "type": "integer", "minimum": 0 },
            "peak_vram_mb": { "type": "integer", "minimum": 0 }
          }
        },
        "watermarked": {
          "description": "True when the worker marked the output (e.g. synthetic-face policy).",
          "type": "boolean"
        }
      }
    },
    "cancel": {
      "description": "Host -> worker. The worker answers the run with error code cancelled.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "job"],
      "properties": {
        "type": { "const": "cancel" },
        "id": { "$ref": "#/$defs/id" },
        "job": { "$ref": "#/$defs/jobId" }
      }
    },
    "unload": {
      "description": "Host -> worker: free an implementation on one device, or on every device when device is absent. Answered by stats.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "impl"],
      "properties": {
        "type": { "const": "unload" },
        "id": { "$ref": "#/$defs/id" },
        "impl": { "$ref": "#/$defs/impl" },
        "device": { "$ref": "#/$defs/device" }
      }
    },
    "stats": {
      "description": "Worker -> host: current residency, after unload or unprompted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "loaded"],
      "properties": {
        "type": { "const": "stats" },
        "id": { "$ref": "#/$defs/id" },
        "reply_to": { "$ref": "#/$defs/replyTo" },
        "loaded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["impl", "device", "vram_mb"],
            "properties": {
              "impl": { "$ref": "#/$defs/impl" },
              "device": { "$ref": "#/$defs/device" },
              "vram_mb": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "rss_mb": { "type": "integer", "minimum": 0 }
      }
    },
    "error": {
      "description": "Either direction. Answers a request when reply_to is set.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "code", "message"],
      "properties": {
        "type": { "const": "error" },
        "id": { "$ref": "#/$defs/id" },
        "reply_to": { "$ref": "#/$defs/replyTo" },
        "job": { "$ref": "#/$defs/jobId" },
        "code": {
          "enum": ["oom", "invalid_input", "model_error", "model_missing", "unsupported", "limit_reached", "cancelled", "protocol", "crash"]
        },
        "message": { "type": "string", "maxLength": 2000 },
        "retryable": { "type": "boolean" }
      }
    },
    "shutdown": {
      "description": "Host -> worker: finish or cancel jobs, unload and exit 0.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "shutdown" },
        "id": { "$ref": "#/$defs/id" }
      }
    }
  }
}
