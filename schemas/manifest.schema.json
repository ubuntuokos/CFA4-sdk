{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ubuntuokos/CFA4-sdk/schemas/manifest.schema.json",
  "title": "CFA4 AI capability manifest",
  "description": "One implementation of one AI capability. Written as TOML, validated after parsing. Version 7 (2026-11-13: every execution path records its golden-output check against the reference path); versions 1 (no languages, AI- ids, M1-M12), 2 (one-field licence, weights without url, revision and format), 3, 4, 5 and 6 (validated execution paths without the golden check; 6 has no edition field) are still accepted.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "manifest_version": { "const": 1 } } },
      "then": {
        "properties": {
          "capability": {
            "properties": {
              "id": { "pattern": "^AI-[0-9]{3}$" },
              "family": { "pattern": "^M([1-9]|1[0-2])$" },
              "languages": false
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "manifest_version": { "enum": [3, 4, 5, 6, 7] } } },
      "then": {
        "properties": {
          "license": { "$ref": "#/$defs/licenseV3" },
          "weights": { "items": { "$ref": "#/$defs/weightV3" } }
        }
      },
      "else": {
        "properties": {
          "license": { "$ref": "#/$defs/licenseV1" },
          "weights": { "items": { "$ref": "#/$defs/weightV1" } }
        }
      }
    },
    {
      "if": { "properties": { "manifest_version": { "enum": [4, 5, 6, 7] } } },
      "else": {
        "properties": {
          "resources": {
            "properties": {
              "vram_mb": { "propertyNames": { "not": { "pattern": "^any" } } },
              "fps_hint": { "propertyNames": { "not": { "pattern": "^any" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "manifest_version": { "enum": [5, 6, 7] } } },
      "then": { "required": ["paths"] },
      "else": { "properties": { "paths": false } }
    },
    {
      "if": { "properties": { "manifest_version": { "const": 7 } } },
      "then": { "properties": { "paths": { "items": { "properties": { "validated": { "required": ["golden"] } } } } } },
      "else": { "properties": { "paths": { "items": { "properties": { "validated": { "properties": { "golden": false } } } } } } }
    }
  ],
  "required": ["manifest_version", "capability", "runtime", "io", "resources", "license"],
  "properties": {
    "manifest_version": { "enum": [1, 2, 3, 4, 5, 6, 7] },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "impl", "version", "shape", "scope"],
      "properties": {
        "id": {
          "description": "Functional type: AI-nnn from the 200-type list (video, image); AU-nnn from the audio list (version 2).",
          "type": "string",
          "pattern": "^A[IU]-[0-9]{3}$"
        },
        "impl": { "$ref": "#/$defs/slug" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "family": {
          "description": "Engine family M1-M12; M13-M15 from version 2.",
          "type": "string",
          "pattern": "^M([1-9]|1[0-5])$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "shape": {
          "description": "Input/output shape, e.g. clip+mask->clip.",
          "type": "string",
          "pattern": "^[a-z0-9_+]+->[a-z0-9_+]+$"
        },
        "scope": { "enum": ["frame", "window", "clip", "generative"] },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "type": "integer", "minimum": 0, "maximum": 1024 },
            "after": { "type": "integer", "minimum": 0, "maximum": 1024 }
          }
        },
        "languages": {
          "description": "Version 2. Languages handled, as BCP 47 language tags (RFC 5646 syntax, case-insensitive; irregular grandfathered tags are not accepted) (en, zh-Hans, hu; constructed languages by ISO 639-3 code such as tlh or qya, else art-x-<name>). Absent means language-independent. The host picks an implementation per segment language.",
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 64, "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+)$" }
        }
      },
      "if": { "properties": { "scope": { "const": "window" } } },
      "then": { "required": ["window"] }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["candle", "onnx", "python", "remote"] },
        "providers": {
          "description": "Execution providers in preference order.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["cuda", "tensorrt", "migraphx", "rocm", "openvino", "cpu"] }
        },
        "precision": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["fp32", "fp16", "bf16", "fp8", "int8", "int4"] }
        },
        "env": {
          "description": "Worker environment name; python only. Empty means the shared environment.",
          "type": "string",
          "pattern": "^([a-z0-9][a-z0-9-]*)?$"
        },
        "protocol": {
          "description": "Worker protocol major version this implementation speaks.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } },
        "max_resolution": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1, "maximum": 16384 },
            { "type": "integer", "minimum": 1, "maximum": 16384 }
          ],
          "items": false,
          "minItems": 2
        },
        "tiling": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vram_mb"],
      "properties": {
        "vram_mb": {
          "description": "Measured VRAM per resolution, optionally per precision (\"1080p\" or \"1080p@fp8\"). From manifest version 4, \"any\" (or \"any@fp16\") marks a value that does not depend on the frame size, for audio and text capabilities.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/resolutionKey" },
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1048576 }
        },
        "ram_mb": { "type": "integer", "minimum": 0 },
        "load_ms": { "type": "integer", "minimum": 0 },
        "fps_hint": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/resolutionKey" },
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preview": { "$ref": "#/$defs/tier" },
        "standard": { "$ref": "#/$defs/tier" },
        "final": { "$ref": "#/$defs/tier" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic": { "type": "boolean" },
        "seedable": { "type": "boolean" },
        "cancellable": { "enum": ["none", "chunk", "step"] },
        "checkpoint": { "type": "boolean" }
      }
    },
    "weights": {
      "description": "Where the user obtains the model. CFA4 does not distribute models. Item shape depends on manifest_version.",
      "type": "array",
      "items": { "type": "object" }
    },
    "license": {
      "description": "Licence of the implementation. Shape depends on manifest_version.",
      "type": "object"
    },
    "paths": {
      "description": "Version 5: the validated execution paths. The capability is available on a machine only if at least one path fits it above the CFA4 AI minimum (12 GB VRAM, 16 GB RAM); a slower path is offered with its estimate and the user decides. Exactly one path is the reference; every other path states how far its output may differ from it.",
      "type": "array",
      "minItems": 1,
      "contains": { "type": "object", "required": ["reference"], "properties": { "reference": { "const": true } } },
      "minContains": 1,
      "maxContains": 1,
      "items": { "$ref": "#/$defs/path" }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": {
          "description": "Relative path of the parameter JSON Schema; the Qt settings panel is generated from it.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.json$"
        }
      }
    }
  },
  "$defs": {
    "weightFile": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "weightPrecision": { "enum": ["fp32", "fp16", "bf16", "fp8", "int8", "int4"] },
    "weightV1": {
      "description": "Versions 1 and 2.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "$ref": "#/$defs/weightFile" },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_mb": { "type": "integer", "minimum": 0 },
        "precision": { "$ref": "#/$defs/weightPrecision" }
      }
    },
    "weightV3": {
      "description": "Version 3: a pinned, verifiable source.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "url", "revision", "format"],
      "properties": {
        "file": { "$ref": "#/$defs/weightFile" },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "revision": {
          "description": "Immutable revision of the source, e.g. a commit hash. Moving names are refused.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "not": { "enum": ["main", "master", "latest", "HEAD", "head"] }
        },
        "format": {
          "description": "File format. The host loads only onnx and safetensors before the PyTorch gate.",
          "enum": ["onnx", "safetensors", "gguf", "pt", "bin", "ckpt"]
        },
        "variant": {
          "description": "Variant of the same model, e.g. a quantization.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
        },
        "size_mb": { "type": "integer", "minimum": 0 },
        "precision": { "$ref": "#/$defs/weightPrecision" }
      }
    },
    "licenseV1": {
      "description": "Versions 1 and 2.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "model", "commercial"],
      "properties": {
        "code": { "description": "SPDX expression of the implementation code.", "type": "string", "minLength": 1 },
        "model": { "description": "SPDX expression or LicenseRef of the weights.", "type": "string", "minLength": 1 },
        "commercial": { "description": "Commercial use allowed by both code and model.", "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "licensePart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "commercial"],
      "properties": {
        "spdx": {
          "description": "SPDX expression, LicenseRef-..., or NOASSERTION when not known. NOASSERTION blocks in the code and dependencies parts; in the weights and dataset parts the user is responsible and the host only asks for acceptance once (docs/protocol.md section 5).",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commercial": {
          "description": "Whether this part allows commercial use. unknown blocks in the code and dependencies parts; in the weights and dataset parts the host warns (more strongly for a commercial request) but does not block.",
          "enum": ["yes", "no", "unknown"]
        },
        "url": { "description": "Where the licence text is.", "type": "string", "pattern": "^https://" }
      }
    },
    "licenseV3": {
      "description": "Version 3: four separately licensed parts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "dependencies", "weights", "dataset"],
      "properties": {
        "code": { "description": "The worker's own code.", "$ref": "#/$defs/licensePart" },
        "dependencies": { "description": "The runtime and libraries the worker loads.", "$ref": "#/$defs/licensePart" },
        "weights": { "description": "The model weights.", "$ref": "#/$defs/licensePart" },
        "dataset": { "description": "The training data, as far as known.", "$ref": "#/$defs/licensePart" },
        "notes": { "type": "string" }
      }
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "precision", "vram_mb", "validated"],
      "if": { "required": ["reference"], "properties": { "reference": { "const": true } } },
      "then": { "properties": { "tolerance": false, "validated": { "properties": { "golden": { "properties": { "worst": false } } } } } },
      "else": { "required": ["tolerance"], "properties": { "validated": { "properties": { "golden": { "required": ["worst"] } } } } },
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "reference": { "description": "The path every other path is compared with.", "type": "boolean" },
        "provider": { "enum": ["cuda", "tensorrt", "migraphx", "rocm", "openvino", "cpu"] },
        "precision": { "$ref": "#/$defs/weightPrecision" },
        "offload": { "description": "none: the model stays in VRAM; partial: part of it moves to RAM while it runs.", "enum": ["none", "partial"] },
        "tiling": { "description": "The path splits frames into overlapping tiles.", "type": "boolean" },
        "vram_mb": {
          "description": "Measured peak VRAM on this path per resolution key.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/resolutionKey" },
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1048576 }
        },
        "ram_mb": { "type": "integer", "minimum": 0 },
        "fps_hint": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/resolutionKey" },
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "tolerance": {
          "description": "How far this path's output may differ from the reference path. The host switches to this path on its own (out-of-memory ladder) only within this tolerance; a path that changes the result needs the user's approval.",
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "value", "automatic"],
          "properties": {
            "metric": { "enum": ["exact", "max_abs", "psnr_db", "boundary_ms"] },
            "value": { "type": "number", "minimum": 0 },
            "automatic": { "description": "true: the result stays within the tolerance, so the host may switch on its own; false: the user approves the switch.", "type": "boolean" }
          }
        },
        "validated": {
          "description": "Where and when the path was measured under run-minspec.sh.",
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "date", "profile"],
          "properties": {
            "device": { "type": "string", "minLength": 1, "maxLength": 120 },
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "profile": { "enum": ["ajanlott", "minimum"] },
            "golden": {
              "description": "Version 7: the result check against golden outputs. The reference path produced the golden outputs of the set; every other path ran the same cases and worst is its largest deviation from them in its tolerance metric (smallest PSNR for psnr_db). worst must lie within the tolerance: at most value for exact (then 0), max_abs and boundary_ms, at least value for psnr_db. A deterministic reference path must reproduce its golden outputs bit for bit. The host refuses a path whose check is missing or out of tolerance.",
              "type": "object",
              "additionalProperties": false,
              "required": ["set", "cases"],
              "properties": {
                "set": { "description": "Name of the golden input set in the implementation's test data.", "$ref": "#/$defs/slug" },
                "cases": { "type": "integer", "minimum": 1, "maximum": 100000 },
                "worst": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "resolutionKey": { "pattern": "^(any|(360|480|540|720|1080|1440|2160|4320)p)(@(fp32|fp16|bf16|fp8|int8|int4))?$" },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "type": { "enum": ["frame", "mask", "audio", "text", "depth", "flow", "points", "json"] },
        "color": { "enum": ["srgb", "rec709", "rec2020-pq", "rec2020-hlg", "linear-srgb", "acescg"] },
        "format": { "enum": ["rgb8", "rgba8", "rgb16f", "rgba16f", "rgba32f", "gray8", "gray16", "gray32f", "pcm-f32"] },
        "optional": { "type": "boolean" }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "steps": { "type": "integer", "minimum": 1 },
        "params": { "type": "object" }
      }
    }
  }
}
